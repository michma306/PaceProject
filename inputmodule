# =========================
# STEP 0 - SET UP LLM MODELS
# =========================

Settings.llm = Ollama(model="llama3.2:3b", request_timeout=360.0)

embed_model = HuggingFaceEmbedding(model_name="BAAI/bge-small-en")
Settings.embed_model = embed_model


# =========================
# FUNCTION 1 - READ FILES
# =========================

def read_uploaded_file(uploaded_file):
    """
    Read one uploaded .txt or .docx file and return plain text of the contents of the file. 

    Args:
        uploaded_file: a file either in txt form or docx form.
        returns the plain text of contents of the file in form of String. 
    """

    filename = uploaded_file.name.lower()

    #read txt file.

    if filename.endswith(".txt"):
        return uploaded_file.read().decode("utf-8", errors="ignore")

    #read docx file. 

    if filename.endswith(".docx"):
        doc = DocxDocument(uploaded_file)
        paragraphs = [p.text for p in doc.paragraphs if p.text.strip()]
        return "\n".join(paragraphs)

    #read pdf file

    if filename.endswith(".pdf"):
        reader = PdfReader(uploaded_file)
        text = ""
        for page in reader.pages:
            text += (page.extract_text() or "") + "\n"
        return text        

    #default blank empty String.
    return ""


# =========================
# FUNCTION 2 - BUILD RAG INDEX
# =========================

def build_rag_index(documents):
    """
    Build and save a persistent ChromaDB RAG index.

    Args:
        documents: a list of document objects.
        returns a permanent RAG index created by LLM model.     
    """

    db = chromadb.PersistentClient(path="./pacesync_chroma_db")

    chroma_collection = db.get_or_create_collection("pacesync_input_module")

    vector_store = ChromaVectorStore(chroma_collection=chroma_collection)

    storage_context = StorageContext.from_defaults(vector_store=vector_store)

    index = VectorStoreIndex.from_documents(
        documents,
        storage_context=storage_context,
        embed_model=Settings.embed_model
    )

    return index


# =========================
# FUNCTION 3 - EXTRACT JSON
# =========================

def extract_json_from_response(response_text):
    """
    Extract JSON text from the LLM response and convert it to a Python dictionary.

    Args:
        response_text is a long string responded by AI model after querying a specific file.
        returns a json dictionary 
    """
    response_text = str(response_text).strip()

    print("\n========== RAW LLM RESPONSE ==========")
    print(response_text)
    print("======================================\n")

    match = re.search(r"\{.*\}", response_text, re.DOTALL)

    if not match:
        print("No JSON object found in LLM response.")
        print(response_text)

        return {
            "standardized_description": "Not specified",
            "business_function": "Not specified",
            "deliverable_type": "Not specified",
            "time_period": "Not specified",
            "stakeholder": "Not specified"
        }

    json_text = match.group(0)
    return json.loads(json_text)

    
