# =========================
# FUNCTION 4 - EXTRACT WORK ITEM INFO
# =========================

def extract_work_item_fields(index, source_filename):
    """
    Query the RAG index and extract structured work-item fields for one source file.

    Args:
        index - permanent index created by LLM model after reading an array of documents.
        source_filename is the name of each file to be read and indexed in the form of String.
        returns a json file extracting structured work-item fields for that source_filename. 
    """

    query_engine = index.as_query_engine(llm=Settings.llm)

    #Build up a prompt to query the file. 
    prompt = f"""
    You are extracting structured business information from the document named: {source_filename}.

    Use only information from this document. You cannot use any other information from anywhere else.

    Return ONLY valid JSON in this exact format:

    {{
      "standardized_description": "...",
      "business_function": "...",
      "deliverable_type": "...",
      "time_period": "...",
      "stakeholder": "..."
    }}

    Rules:
    - MUST RETURN VALID JSON FORMAT
    - NO MARKUPS OR MARKDOWNS
    - no special characters other than numbers and letters
    - standardized_description should be concise and preserve the essential business meaning.
    - standardized_description should be no more than 15 words.
    - the time_period should be in the format of year-month.
    - Preserve objective, scope, summary, conclusion, recommendation in the standardized_description.
    - Keep deliverable, timing, and stakeholder if available.
    - Limit deliverable to 2 words.
    - Limit business function to 2 words.
    - Limit stakeholder to 2 words.
    - If a field is not clear, use "Not specified".
    - Do not invent details.
    """
    #Query and record the response.
    response = query_engine.query(prompt)

    #Extract the required information from the response and return a dictionary. 
    extracted = extract_json_from_response(str(response))

    return extracted


# =========================
# FUNCTION 5 - MAIN INPUT MODULE
# =========================

def run_input_module(uploaded_files):
    """
    Main function called by webapp.py.

    Input:
        uploaded_files is a list of files from Streamlit st.file_uploader

    Output:
        work_item_df is a dataframe containing: file_name, standardized_description, business_function, deliverable_type, time_period and stakeholder. 
    """

    #Set up empty list for file objects. 
    documents = []

    # Step 1: Read uploaded files uniformly and convert them into LlamaIndex documents
    for uploaded_file in uploaded_files:

        # read a single file.  
        file_text = read_uploaded_file(uploaded_file)

        # create a document object containing the filename and the contents.
        doc = Document(
            text=file_text,
            metadata={"source_filename": uploaded_file.name}
        )

        # append the document object to the documents list. 
        documents.append(doc)

    # Step 2: Build persistent RAG index
    index = build_rag_index(documents)


    # Step 3: Extract structured fields for each uploaded file
    # create a temporary list. 
    records = []

    # looping throughout the uploaded file list and generate list of dictionaries.
    for i, uploaded_file in enumerate(uploaded_files, start=1):

        # extract necessary information from each file.
        # anticipate LLM hallucination and produces some errors
        # keep on extracting but produce error messages for managers
        try:
            extracted = extract_work_item_fields(
                index=index,
                source_filename=uploaded_file.name
            )

            # generate each record by reading each entry of the dictionary. 
            record = {
                "work_item_id": f"WI{i:03d}",
                "source_filename": uploaded_file.name,
                "standardized_description": extracted["standardized_description"],
                "business_function": extracted["business_function"],
                "deliverable_type": extracted["deliverable_type"],
                "time_period": extracted["time_period"],
                "stakeholder": extracted["stakeholder"],
                "extraction_status": "Success"
            }
    
        # LLM generated some errors
        # we have to enter the information manually
        except Exception as e:
            print("Skipping file due to error", uploaded_file.name)
            print("Error", e)

            record = {
                "work_item_id": f"WI{i:03d}",
                "source_filename": uploaded_file.name,
                "standardized_description": "Extraction failed. Manual review required.",
                "business_function": "Not specified",
                "deliverable_type": "Not specified",
                "time_period": "Not specified",
                "stakeholder": "Not specified",
                "extraction_status": "Failed"
            }


        # append the record to the list of record. 
        records.append(record)

    # Step 4: Convert records into dataframe
    work_item_df = pd.DataFrame(records)

    return work_item_df
